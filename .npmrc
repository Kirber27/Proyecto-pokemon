; Registry publico. Evita heredar el Nexus interno del .npmrc global,
; que solo es alcanzable dentro de la red corporativa / VPN.
registry=https://registry.npmjs.org/

; Se aplica a todos los scripts de npm en Mac, Windows y Linux por igual.
; Reemplaza el prefijo "NODE_OPTIONS=..." que solo funcionaba en shells POSIX.
node-options=--disable-warning=ExperimentalWarning
